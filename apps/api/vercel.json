{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile && pnpm --filter @resenhometro/shared build",
  "buildCommand": "mkdir -p public",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api" },
    { "source": "/:a", "destination": "/api?__p=/:a" },
    { "source": "/:a/:b", "destination": "/api?__p=/:a/:b" },
    { "source": "/:a/:b/:c", "destination": "/api?__p=/:a/:b/:c" },
    { "source": "/:a/:b/:c/:d", "destination": "/api?__p=/:a/:b/:c/:d" }
  ]
}
