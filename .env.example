# API
API_PORT=3333
JWT_SECRET=change-me-dev-secret
PUBLIC_API_URL=http://localhost:3333
WEB_ORIGIN=http://localhost:3000

# Banco (opcional). Sem DATABASE_URL a API usa PostgreSQL embarcado (PGlite) em apps/api/data.
# DATABASE_URL=postgres://resenhometro:resenhometro@localhost:5432/resenhometro

# CORS extra (produção)
# CORS_ORIGINS=https://seu-front.vercel.app

# Spotify (opcional — local: use 127.0.0.1, Spotify não aceita localhost)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3333/spotify/callback

# E-mail (esqueci a senha). Gmail: smtp.gmail.com + senha de app.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Resenhômetro <seuemail@gmail.com>

# Web
NEXT_PUBLIC_API_URL=http://localhost:3333
