# Copie os nomes abaixo para o painel da Vercel (Settings → Environment Variables).
# NÃO coloque valores reais neste arquivo nem commite um .env de produção.

# === Projeto Vercel da API (Root Directory = apps/api) ===
JWT_SECRET=gere-um-segredo-longo-aleatorio
DATABASE_URL=postgres://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_key_nunca_expor_no_frontend
SUPABASE_STORAGE_BUCKET=resenhometro-uploads
# Bucket acima deve ser público no dashboard do Supabase (Storage → bucket → Public).
PUBLIC_API_URL=https://seu-projeto-api.vercel.app
WEB_ORIGIN=https://seu-projeto-web.vercel.app
CORS_ORIGINS=https://seu-projeto-web.vercel.app

